{
  "name": "leafplayer",
  "version": "1.4.0",
  "description": "",
  "author": "Paul Schwörer <hello@paulschwoerer.de>",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.18.0"
  },
  "main": "main.ts",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file .env --watch main.ts serve",
    "check": "tsc",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write --list-different .",
    "test": "ava",
    "test:watch": "ava --watch",
    "release": "npx standard-version",
    "install-git-hooks": "lefthook install"
  },
  "ava": {
    "files": [
      "lib/**/*.test.ts",
      "test/**/*.test.ts"
    ],
    "extensions": [
      "ts"
    ]
  },
  "dependencies": {
    "@fastify/static": "^9.1.3",
    "awilix": "^6.1.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.10.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.3",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "leafplayer-common": "file:./common",
    "music-metadata": "^11.12.3",
    "sharp": "^0.34.5",
    "ua-parser-js": "^1.0.41",
    "uid-safe": "^2.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/ua-parser-js": "^0.7.36",
    "@types/uid-safe": "^2.1.5",
    "ava": "^4.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "lefthook": "^2.1.9",
    "prettier": "^3.9.4",
    "testdouble": "^3.16.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0"
  }
}
