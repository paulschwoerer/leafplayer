{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "incremental": true,
    "noEmit": true
  },
  "include": [
    "./common/**/*.ts",
    "./lib/**/*.ts",
    "./test/**/*.ts",
    "./main.ts"
  ]
}
